{
  "name": "pugneum-repository",
  "private": true,
  "packageManager": "npm@10.9.9",
  "devDependencies": {
    "prettier": "^3.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheusmoreira/pugneum.git"
  },
  "scripts": {
    "docs:check": "node scripts/sync-root-readme.js --check",
    "docs:sync": "node scripts/sync-root-readme.js --write",
    "prettier:check": "prettier --ignore-path .gitignore --list-different \"./**/*.js\"",
    "format": "prettier --ignore-path .gitignore --write \"./**/*.js\"",
    "release:check": "node scripts/check-release-packages.js",
    "test": "node --experimental-test-snapshots scripts/run-tests.js",
    "test:update-snapshots": "node --experimental-test-snapshots --test-update-snapshots scripts/run-tests.js"
  },
  "workspaces": [
    "packages/error",
    "packages/lexer",
    "packages/parser",
    "packages/loader",
    "packages/loader/test/fixtures/mock-lib",
    "packages/loader/test/fixtures/unscoped-mock-lib",
    "packages/linker",
    "packages/filterer",
    "packages/renderer",
    "packages/walker",
    "packages/filesystem",
    "packages/pugneum",
    "packages/filter/highlight.js",
    "packages/filter/prismjs",
    "packages/filter/table",
    "packages/feed",
    "packages/mixins"
  ],
  "engines": {
    "node": ">=22.5.0",
    "npm": "10.9.9"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/matheusmoreira"
}
