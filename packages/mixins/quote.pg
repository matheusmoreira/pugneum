mixin quote(source?)
  figure
    blockquote(cite="#{source?}")
      block
    given caption
      figcaption
        block caption

mixin citation(separator=', ')
  given attribution
    block attribution
  given title
    given attribution
      | #{separator}
    cite
      block title

mixin linked-citation(href separator=', ')
  given attribution
    block attribution
  given title
    given attribution
      | #{separator}
    cite
      a(href="#{href}")
        block title
