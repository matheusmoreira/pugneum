mixin breadcrumbs(label=Breadcrumb)
  nav(aria-label="#{label}")
    ol
      block

mixin breadcrumbs-labelledby(id)
  nav(aria-labelledby="#{id}")
    ol
      block

mixin breadcrumb(href)
  li
    a(href="#{href}")
      block

mixin breadcrumb-current
  li
    span(aria-current="page")
      block

mixin breadcrumb-current-link(href)
  li
    a(href="#{href}" aria-current="page")
      block
